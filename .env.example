# Copy this file to .env before `docker compose up` (compose loads .env from
# this directory automatically). See docs/quickstart.md.

# Required. Signs/verifies dxctl session tokens (HMAC-SHA256) - the denarix
# container refuses to start without it. Generate one with:
#   openssl rand -base64 32
DENARIX_JWT_SECRET=

# Optional, but needed to bootstrap your first login: on startup, if no
# global admin exists yet, this email is granted global-admin (creating the
# app_user row if needed). It's a no-op once any admin exists, so it's safe
# to leave set after the first run. Use the email you'll register a passkey
# with via `dxctl login`.
DENARIX_BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Only change these if you're exposing denarix beyond localhost - they control
# the WebAuthn relying-party origin the browser's passkey ceremony is
# scoped to, and must match wherever the HTTP auth pages are actually
# reached from.
DENARIX_PUBLIC_BASE_URL=http://localhost:9091
DENARIX_RP_ID=localhost
